{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nihongo-Cho",
  "mainBinaryName": "Nihongo-Cho",
  "version": "1.1.2",
  "identifier": "io.github.caffecayu.nihongocho",
  "build": { "frontendDist": "../docs" },
  "app": {
    "windows": [
      { "title": "毎日にほんご帳", "width": 1180, "height": 820, "minWidth": 380, "minHeight": 560, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "caffecayu",
    "shortDescription": "毎日にほんご帳",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese"], "installMode": "currentUser" }
    }
  }
}
